# Google Gemini API Key (Get a free one at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here

# Gemini Model (gemini-3.5-flash is stable, fast, and free-tier supported)
GEMINI_MODEL=gemini-3.5-flash

# SQL Server Configuration
# For default instance, use: localhost
# For named instance, use: localhost\SQLEXPRESS or localhost\MSSQLSERVER2025
SQL_SERVER=localhost
SQL_DATABASE=master
SQL_DRIVER=ODBC Driver 17 for SQL Server
SQL_TRUSTED_CONNECTION=yes

# Optional: If SQL_TRUSTED_CONNECTION=no, provide SQL Authentication credentials:
# SQL_USERNAME=sa
# SQL_PASSWORD=YourStrongPassword

